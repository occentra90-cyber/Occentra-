# SnapScan merchant Payment Link (public URL; no new WordPress hosting needed).
SNAPSCAN_PAYMENT_URL=https://pos.snapscan.io/qr/QnQsqROg
# Private SnapScan merchant API key. Add as a Vercel Secret, never NEXT_PUBLIC_.
SNAPSCAN_API_KEY=
# SnapScan signs webhook bodies with this separate secret. Never put it in public JS.
SNAPSCAN_WEBHOOK_AUTH_KEY=
# Stay off until database migration, merchant URL and real payment verification are tested.
SNAPSCAN_CHECKOUT_ENABLED=false
# Optional override for production return URLs.
OCCENTRA_PUBLIC_URL=https://occentra-occentra.vercel.app
